---
import { profile } from '../data/resume';

const cardImages = [
  '/cards/loveisland.png',
  '/cards/616.png',
  '/cards/moana.png',
  '/cards/droid.png',
];
const cardPositions = [
  { rotateY: -22, rotateZ: -5, x: -100, mdX: -210, depth: -60, z: 1 },
  { rotateY: -10, rotateZ: -2, x: -33, mdX: -70, depth: -25, z: 2 },
  { rotateY: 10, rotateZ: 2, x: 33, mdX: 70, depth: 10, z: 3 },
  { rotateY: 22, rotateZ: 5, x: 100, mdX: 210, depth: 35, z: 4 },
];
---

<section id="top" class="pt-20 md:pt-28 pb-8 text-center px-3 md:px-4 overflow-x-hidden">
  <div class="max-w-5xl mx-auto">

    <p class="font-mono text-[11px] uppercase tracking-[0.3em] text-stone-500">
      {profile.location}
    </p>
    <p class="font-mono text-[10px] uppercase tracking-[0.25em] text-stone-400 mt-1">
      <a href={`mailto:${profile.email}`} class="hover:text-[#c49a3c] transition-colors">{profile.email}</a>
    </p>

    <h1 class="mt-10 font-display text-[clamp(3rem,12vw,9rem)] font-bold leading-[0.85] tracking-tight text-stone-900">
      Lauren Wiener
    </h1>

    <div class="mt-6 flex items-center justify-center">
      <div class="card-scene relative w-full h-40 md:w-[44rem] md:h-64">
        {cardImages.map((src, i) => {
          const pos = cardPositions[i];
          return (
            <div
              class="card absolute w-28 h-36 md:w-36 md:h-48 rounded-xl shadow-2xl overflow-hidden ring-1 ring-stone-200 cursor-pointer group"
              style={`left:50%;top:50%;--card-rotateY:${pos.rotateY}deg;--card-rotateZ:${pos.rotateZ}deg;--card-x:${pos.x}px;--card-md-x:${pos.mdX}px;--card-depth:${pos.depth}px;z-index:${pos.z}`}
            >
              <img
                src={src}
                alt=""
                class="w-full h-full object-cover"
                loading="eager"
              />
            </div>
          );
        })}
      </div>
    </div>

    <h2 class="mt-6 font-display text-[clamp(2.5rem,6vw,5rem)] font-normal leading-[0.95] tracking-tight text-stone-400 select-none">
      Digital Marketing & Creative Development
    </h2>

    <div class="mt-14 md:mt-16">
      <p class="font-mono text-[10px] uppercase tracking-[0.3em] text-stone-400 mb-5">
        Studios & Networks
      </p>
      <div class="flex items-center justify-center gap-6 md:gap-8 flex-wrap">
        {[
          { name: 'Disney', file: 'disney.png' },
          { name: 'Marvel', file: 'marvel.png' },
          { name: 'Pixar', file: 'pixar.png' },
          { name: 'Lucasfilm', file: 'lucasfilm.png' },
          { name: 'Leftfield Pictures', file: 'leftfield.png' },
          { name: 'ITV', file: 'itv.png' },
        ].map((brand) => (
          <img
            src={`/logos/${brand.file}`}
            alt={brand.name}
            class="h-10 md:h-12 w-auto opacity-80 hover:opacity-100 transition-opacity"
            loading="lazy"
          />
        ))}
      </div>
    </div>

    <p class="mt-12 max-w-2xl mx-auto text-base md:text-lg text-stone-600 leading-relaxed">
      {profile.summary}
    </p>

    <div class="mt-8">
      <a
        href="/LaurenWienerResume.pdf"
        target="_blank"
        class="inline-flex items-center gap-2 px-5 py-2.5 text-sm font-medium text-white bg-stone-900 hover:bg-[#c49a3c] transition-colors rounded-full"
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
          <polyline points="7 10 12 15 17 10" />
          <line x1="12" y1="15" x2="12" y2="3" />
        </svg>
        View Resume
      </a>
    </div>

    <div class="mt-3">
      <a
        href={profile.linkedin}
        target="_blank"
        rel="noopener"
        class="text-sm text-stone-500 hover:text-[#c49a3c] transition-colors"
      >
        View my LinkedIn
      </a>
    </div>

  </div>
</section>

<style>
  .card-scene {
    perspective: 1200px;
    transform-style: preserve-3d;
  }

  .card {
    transform: translate(-50%, -50%) translateX(var(--card-x, 0px)) rotateY(var(--card-rotateY, 0deg)) rotateZ(var(--card-rotateZ, 0deg)) translateZ(var(--card-depth, 0px));
    transition: transform 0.6s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.6s ease, z-index 0s step-start;
    transform-origin: center bottom;
  }

  @media (min-width: 768px) {
    .card {
      transform: translate(-50%, -50%) translateX(var(--card-md-x, var(--card-x, 0px))) rotateY(var(--card-rotateY, 0deg)) rotateZ(var(--card-rotateZ, 0deg)) translateZ(var(--card-depth, 0px));
    }
  }

  .card:hover {
    z-index: 50 !important;
    transform: translate(-50%, -50%) translateX(var(--card-md-x, var(--card-x, 0px))) rotateY(0deg) rotateZ(0deg) translateZ(calc(var(--card-depth, 0px) + 80px)) scale(1.15);
    box-shadow: 0 40px 80px -12px rgba(0, 0, 0, 0.4);
    transition: transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.5s ease, z-index 0s step-start;
  }
</style>
