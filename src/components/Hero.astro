---
import { profile } from '../data/resume';

const cards = [
  { image: 'loveisland', title: 'Love Island', tilt: -4, turn: -12 },
  { image: '616', title: 'Marvel’s 616', tilt: -1.5, turn: -4 },
  { image: 'moana', title: 'Moana', tilt: 1.5, turn: 4 },
  { image: 'droid', title: 'R2-D2 and BB-8 from Star Wars', tilt: 4, turn: 12 },
];
---

<section id="top" class="pt-20 md:pt-28 pb-8 text-center px-3 md:px-4 overflow-x-hidden">
  <div class="max-w-5xl mx-auto">

    <p class="font-mono text-[11px] uppercase tracking-[0.3em] text-stone-500">
      {profile.location}
    </p>
    <p class="font-mono text-[10px] uppercase tracking-[0.25em] text-stone-400 mt-1">
      <a href={`mailto:${profile.email}`} class="hover:text-[#c49a3c] transition-colors">{profile.email}</a>
    </p>

    <h1 class="mt-10 font-display text-[clamp(3rem,12vw,9rem)] font-bold leading-[0.85] tracking-tight text-stone-900">
      Lauren Wiener
    </h1>

    <div class="card-scene">
      {cards.map(({ image, title, tilt, turn }) => (
        <div class="card-slot" style={`--tilt:${tilt}deg;--turn:${turn}deg`}>
          <img
            class="card"
            src={`/cards/${image}-360.webp`}
            srcset={`/cards/${image}-360.webp 360w, /cards/${image}-640.webp 640w`}
            sizes="(min-width: 972px) 260px, (min-width: 480px) calc(27.5vw - 7px), calc(29vw - 14px)"
            width="360"
            height="504"
            alt={title}
          />
        </div>
      ))}
    </div>

    <h2 class="mt-6 font-display text-[clamp(2.5rem,6vw,5rem)] font-normal leading-[0.95] tracking-tight text-stone-400 select-none">
      Digital Marketing & Creative Development
    </h2>

    <div class="mt-14 md:mt-16">
      <p class="font-mono text-[10px] uppercase tracking-[0.3em] text-stone-400 mb-5">
        Studios & Networks
      </p>
      <div class="flex items-center justify-center gap-6 md:gap-8 flex-wrap">
        {[
          { name: 'Disney', file: 'disney.png' },
          { name: 'Marvel', file: 'marvel.png' },
          { name: 'Pixar', file: 'pixar.png' },
          { name: 'Lucasfilm', file: 'lucasfilm.png' },
          { name: 'Leftfield Pictures', file: 'leftfield.png' },
          { name: 'ITV', file: 'itv.png' },
        ].map((brand) => (
          <img
            src={`/logos/${brand.file}`}
            alt={brand.name}
            class="h-10 md:h-12 w-auto opacity-80 hover:opacity-100 transition-opacity"
            loading="lazy"
          />
        ))}
      </div>
    </div>

    <p class="mt-12 max-w-2xl mx-auto text-base md:text-lg text-stone-600 leading-relaxed">
      {profile.summary}
    </p>

    <div class="mt-8">
      <a
        href="/LaurenWienerResume.pdf"
        target="_blank"
        class="inline-flex items-center gap-2 px-5 py-2.5 text-sm font-medium text-white bg-stone-900 hover:bg-[#c49a3c] transition-colors rounded-full"
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
          <polyline points="7 10 12 15 17 10" />
          <line x1="12" y1="15" x2="12" y2="3" />
        </svg>
        View Resume
      </a>
    </div>

    <div class="mt-3">
      <a
        href={profile.linkedin}
        target="_blank"
        rel="noopener"
        class="text-sm text-stone-500 hover:text-[#c49a3c] transition-colors"
      >
        View my LinkedIn
      </a>
    </div>

  </div>
</section>

<style>
  .card-scene {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 0.82fr)) minmax(0, 1fr);
    max-width: 56rem;
    margin: clamp(0.75rem, 2vw, 1.5rem) auto 0;
    width: calc(100% - clamp(1.5rem, 5vw, 4rem));
    isolation: isolate;
  }

  .card-slot {
    /* The slot stays still and owns hover while the artwork moves. */
    position: relative;
    padding-block: clamp(0.75rem, 2vw, 1.5rem);
  }

  .card {
    display: block;
    width: calc(100% / 0.82);
    max-width: none;
    height: auto;
    border: 1px solid rgb(255 255 255 / 70%);
    border-radius: clamp(0.625rem, 2vw, 1.5rem);
    background: #e7e5e4;
    box-shadow: 0 0.75rem 1.75rem -0.625rem rgb(28 25 23 / 28%);
    transform: translateX(var(--nudge, 0px)) perspective(64rem) rotateY(var(--turn)) rotateZ(var(--tilt));
    pointer-events: none;
  }

  .card-slot:last-child .card {
    width: 100%;
  }

  @media (hover: hover) and (pointer: fine) {
    .card-slot:hover {
      z-index: 1;
    }

    .card-slot:hover .card {
      transform: none;
    }
  }

  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .card {
      transition: transform 280ms cubic-bezier(0.22, 1, 0.36, 1);
    }

    .card-slot:has(+ .card-slot:hover) {
      --nudge: clamp(-0.75rem, -1vw, -0.25rem);
    }

    .card-slot:hover + .card-slot {
      --nudge: clamp(0.25rem, 1vw, 0.75rem);
    }

    .card-slot:hover .card {
      transform: translateY(clamp(-1rem, -1.25vw, -0.5rem)) perspective(64rem) rotateY(0deg) rotateZ(0deg) scale(1.045);
    }
  }
</style>
