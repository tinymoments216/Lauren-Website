---
import { education, profile } from '../data/resume';
---

<section id="contact" class="py-12 md:py-16 border-t border-stone-200 flip-in">
  <div class="container-tight">

    <!-- Education — Spencer-style, just one line -->
    <div class="flex flex-col sm:flex-row sm:items-center gap-4 sm:gap-8">
      <div class="flex-shrink-0">
        <p class="font-mono text-xs uppercase tracking-[0.2em] text-stone-500">
          <span class="text-[#c49a3c] mr-2">✦</span> Education
        </p>
        <p class="mt-1 font-display text-base text-stone-900">
          {education[0].school}
        </p>
        <p class="mt-0.5 text-sm text-stone-500">
          {education[0].degree}
        </p>
      </div>

      <div class="flex-shrink-0 sm:ml-auto">
        <p class="font-mono text-xs uppercase tracking-[0.2em] text-stone-500">
          <span class="text-[#c49a3c] mr-2">✦</span> Into
        </p>
        <p class="mt-1 text-sm text-stone-600">
          {profile.interests.join(' · ')}
        </p>
      </div>
    </div>

  </div>
</section>