---
import {
  videos,
  formatViews,
  thumbnailUrl,
  isPlaceholder,
  type Video,
} from '../data/videos';

const hasVideos = videos.length > 0;
const sorted: Video[] = [...videos].sort((a, b) => b.views - a.views);
---

<section id="work" class="py-16 md:py-20 flip-in">
  <div class="container-tight">

    <!-- Section header — Spencer-style minimal -->
    <p class="font-mono text-xs uppercase tracking-[0.25em] text-stone-500">
      <span class="text-[#c49a3c] mr-2">✦</span> Work
    </p>
    <h2 class="mt-3 font-display text-4xl md:text-5xl font-normal text-stone-900 tracking-tight">
      Selected projects.
    </h2>

    {hasVideos && (
      <div class="mt-10 grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-5">
        {sorted.map((video: Video, i: number) => (
          <a
            href={video.url}
            target="_blank"
            rel="noopener"
            class="group block"
            aria-label={`Watch "${video.title}"`}
          >
            <div class="relative aspect-square overflow-hidden rounded-xl bg-stone-200 ring-1 ring-stone-200 group-hover:ring-[#c49a3c] transition-all duration-300">
              {isPlaceholder(video) ? (
                <div class="absolute inset-0 flex items-center justify-center bg-gradient-to-br from-stone-800 to-stone-950">
                  <div class="relative flex items-center justify-center">
                    <span class="play-ripple"></span>
                    <span class="play-ripple"></span>
                    <span class="play-ripple"></span>
                    <div class="play-button w-14 h-14 rounded-full bg-stone-900/80 backdrop-blur-sm flex items-center justify-center ring-2 ring-[#c49a3c]/60 group-hover:bg-stone-800/80 transition-colors">
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="#c49a3c" aria-hidden="true">
                        <path d="M8 5v14l11-7z" />
                      </svg>
                    </div>
                  </div>
                </div>
              ) : (
                <img
                  src={thumbnailUrl(video)}
                  alt={video.title}
                  class="absolute inset-0 w-full h-full object-cover"
                  loading="lazy"
                />
              )}

              {/* Hover overlay with brand */}
              <div class="absolute inset-0 bg-stone-900/0 group-hover:bg-stone-900/50 transition-all duration-300 flex items-end p-4">
                <p class="font-mono text-[10px] uppercase tracking-widest text-white opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                  {video.brand}
                </p>
              </div>
            </div>

            {/* Title below — Spencer-style, just the brand line */}
            <p class="mt-3 font-mono text-[10px] uppercase tracking-widest text-stone-500">
              {video.brand}
            </p>
            <h3 class="mt-1 text-sm font-display text-stone-900 group-hover:text-[#c49a3c] transition-colors leading-snug">
              {video.title}
            </h3>
          </a>
        ))}
      </div>
    )}

    {videos.some(isPlaceholder) && (
      <p class="mt-8 text-xs text-stone-500">
        <span class="inline-block w-1 h-1 rounded-full bg-[#c49a3c] align-middle mr-1.5"></span>
        Sample placeholders. Add real video IDs in <code class="mx-1 px-1 py-0.5 rounded bg-stone-200 font-mono text-stone-600 text-xs">src/data/videos.ts</code>
      </p>
    )}
  </div>
</section>