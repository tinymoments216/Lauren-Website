---
import { profile, skills } from '../data/resume';

const listening = [
  { title: 'Las Culturistas', detail: 'Podcast' },
  { title: 'Garbage Sesh', detail: 'Podcast' },
  { title: 'Acquired', detail: 'Podcast' },
  { title: 'Maggie Rogers', detail: 'Artist' },
];

const reading = [
  { title: 'Strangers', detail: 'Belle Burden' },
  { title: 'Who Knew', detail: 'Barry Diller' },
  { title: 'I Regret Almost Everything', detail: 'Keith McNally' },
];

const watching = [
  { title: 'Top Chef', detail: 'Bravo' },
  { title: 'Rafa', detail: 'Netflix' },
  { title: 'The Boys', detail: 'Prime Video' },
  { title: 'Drive to Survive', detail: 'Netflix' },
  { title: 'Hacks', detail: 'Max' },
];

const allSkills = Object.values(skills).flat();
---

<section id="about" class="pt-32 md:pt-40 pb-16 md:pb-20 flip-in">
  <div class="container-tight">

    <div class="flex items-center justify-center gap-4 mb-12">
      <div class="h-px w-16 bg-stone-300"></div>
      <span class="text-[#c49a3c] text-lg">✦</span>
      <div class="h-px w-16 bg-stone-300"></div>
    </div>

    <h2 class="font-display text-4xl md:text-5xl font-normal text-stone-900 tracking-tight">
      A little about me
    </h2>

    <div class="mt-10 flex flex-col md:flex-row gap-8 md:gap-12">
      <!-- Photo -->
      <div class="flex-shrink-0">
        <div class="w-56 h-56 md:w-64 md:h-64 rounded-2xl overflow-hidden ring-4 ring-white shadow-lg">
          <img
            src="/lauren.jpg"
            alt={profile.name}
            class="w-full h-full object-cover"
          />
        </div>
      </div>

      <!-- Content -->
      <div class="flex-1 space-y-6">
        <!-- Bio -->
        <p class="text-stone-600 leading-relaxed">
          When I'm not shaping stories, you'll find me exploring New York, hunting down the best brunch spots, or on the tennis court chasing down a drop shot.
        </p>

        <!-- Skills & Interests -->
        <div>
          <p class="font-mono text-[10px] uppercase tracking-widest text-stone-500 mb-2">
            Skills & Interests
          </p>
          <div class="flex flex-wrap gap-2">
            {allSkills.slice(0, 8).map((skill) => (
              <span class="inline-block px-3 py-1 text-xs text-stone-600 bg-white rounded-full ring-1 ring-stone-200">
                {skill}
              </span>
            ))}
          </div>
          {profile.interests && profile.interests.length > 0 && (
            <div class="flex flex-wrap gap-2 mt-2">
              {profile.interests.map((interest) => (
                <span class="inline-block px-3 py-1 text-xs text-stone-600 bg-white rounded-full ring-1 ring-stone-200">
                  {interest}
                </span>
              ))}
            </div>
          )}
        </div>

        <!-- Listening -->
        <div>
          <p class="font-mono text-[10px] uppercase tracking-widest text-stone-500 mb-2 flex items-center gap-1.5">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 18v-6a9 9 0 0 1 18 0v6"/><path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3zM3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z"/></svg>
            Listening to
          </p>
          <ul class="space-y-1">
            {listening.map((item) => (
              <li class="text-sm text-stone-700">
                <span class="font-medium">{item.title}</span>
                <span class="text-stone-400"> — {item.detail}</span>
              </li>
            ))}
          </ul>
        </div>

        <!-- Reading -->
        <div>
          <p class="font-mono text-[10px] uppercase tracking-widest text-stone-500 mb-2 flex items-center gap-1.5">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
            Reading
          </p>
          <ul class="space-y-1">
            {reading.map((item) => (
              <li class="text-sm text-stone-700">
                <span class="font-medium">{item.title}</span>
                <span class="text-stone-400"> — {item.detail}</span>
              </li>
            ))}
          </ul>
        </div>

        <!-- Watching -->
        <div>
          <p class="font-mono text-[10px] uppercase tracking-widest text-stone-500 mb-2 flex items-center gap-1.5">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="15" rx="2" ry="2"/><polyline points="17 2 12 7 7 2"/></svg>
            Watching
          </p>
          <ul class="space-y-1">
            {watching.map((item) => (
              <li class="text-sm text-stone-700">
                <span class="font-medium">{item.title}</span>
                <span class="text-stone-400"> — {item.detail}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>
